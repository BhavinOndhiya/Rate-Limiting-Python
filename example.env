# =============================
# 🌐 Webshare API Configuration
# =============================

# 🔑 Your Webshare API Key
# Replace this with your actual API key from https://proxy.webshare.io/
API_KEY=your_webshare_api_key_here


# 🌍 Base URL for the Webshare API
BASE_URL=https://proxy.webshare.io/api


# =============================
# 📡 API Endpoints
# (These use BASE_URL for easy substitution)
# =============================

# 👤 User Profile Info Endpoint
PROFILE_URL=${BASE_URL}/profile/

# 💳 Subscription Details Endpoint
SUBSCRIPTION_URL=${BASE_URL}/subscription/

# ⚙️ Proxy Configuration Info Endpoint
CONFIG_URL=${BASE_URL}/proxy/config/

# 📋 Proxy List Endpoint
PROXY_LIST_URL=${BASE_URL}/proxy/list/

# 📊 Proxy Stats Endpoint
PROXY_STATS_URL=${BASE_URL}/proxy/stats/
